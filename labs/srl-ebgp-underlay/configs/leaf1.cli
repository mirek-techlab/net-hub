# leaf1 — eBGP to both spines (AS 65100), advertises its client subnet
# Partial SR Linux CLI config, applied at boot by containerlab (no candidate/commit needed).
routing-policy {
    policy all {
        default-action {
            policy-result accept
        }
    }
}
network-instance default {
    interface ethernet-1/1.0 {
    }
    interface ethernet-1/2.0 {
    }
    interface ethernet-1/3.0 {
    }
    protocols {
        bgp {
            admin-state enable
            autonomous-system 65001
            router-id 10.255.0.11
            group spines {
                peer-as 65100
                export-policy [ all ]
                import-policy [ all ]
                afi-safi ipv4-unicast {
                    admin-state enable
                }
            }
            neighbor 10.0.1.0 {
                peer-group spines
            }
            neighbor 10.0.2.0 {
                peer-group spines
            }
        }
    }
}
